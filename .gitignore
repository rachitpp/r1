# Environment (keep .env.example)
.env
.env.*
!.env.example
!.env.local.example

# Credentials — never commit. GCP service-account keys carry a live private
# key; prefer storing them OUTSIDE the repo entirely and pointing
# GOOGLE_APPLICATION_CREDENTIALS at an absolute path.
*.pem
*.key
service-account*.json
*-service-account.json
gcp-*.json
Project_*.json
credentials*.json

# OS junk
.DS_Store
Thumbs.db

# Local agent settings — per-machine tool permissions, not repo content.
.claude/

# Agent run traces — every model call is metered; traces are kept locally
# for debugging but are not repo content.
backend/var/
