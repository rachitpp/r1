# Backend environment — copy to backend/.env (gitignored) for local dev.
# Values below match docker-compose.yml.

# Required infrastructure.
DATABASE_URL=postgresql://app:app@localhost:5432/codebase_assistant
REDIS_URL=redis://localhost:6379

# Agent model — the prefix selects the provider (SPEC §7.2):
#   gemini*  -> ChatGoogleGenerativeAI  (needs GOOGLE_API_KEY)
#   claude*  -> ChatAnthropic           (needs ANTHROPIC_API_KEY)
#   vertex:* -> ChatVertexAI            (needs GOOGLE_APPLICATION_CREDENTIALS + GCP_PROJECT)
# Default is Gemini's free tier: zero marginal cost for tuning iterations.
AGENT_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# Vertex AI — measurement runs and the strong-model cross-check ONLY.
# Default tuning traffic never routes through Vertex (DECISIONS 2026-07-26).
# Point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON stored
# OUTSIDE the repo; the key file is a live credential.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GCP_PROJECT=
# GCP_LOCATION=us-central1

# Model defaults (override only if you know why).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Cross-encoder rerank — OFF by default (SPEC §5.3). It measured worse-or-equal
# to plain RRF fusion at every k and at MRR, for ~2.4 GB resident. Set true to
# re-enable (the model stays wired so the ablation is measurable).
# RERANK_ENABLED=false

# Hugging Face Hub token (optional). Raises download rate limits; without it
# model pulls still work but may be throttled. Get one at hf.co/settings/tokens.
# HF_TOKEN=

# Mistral — tuning and primary measurement (DECISIONS 2026-07-26, provider
# roles). Token-metered free tier (1 RPS / 500K TPM / ~1B tokens per month);
# needs phone verification at console.mistral.ai. Default workhorse:
# mistral-medium-latest.
# MISTRAL_API_KEY=
