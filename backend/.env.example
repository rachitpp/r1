# Backend environment — copy to backend/.env (gitignored) for local dev.
#
#   cp .env.example .env
#
# The ONLY value you must add is a model API key (see AGENT_MODEL below).
# Everything else already works as shipped.

# Postgres. This value already matches docker-compose.yml — leave it alone
# unless you are pointing at your own database.
DATABASE_URL=postgresql://app:app@localhost:5432/codebase_assistant
# ARQ queue. A managed free tier works: paste the bare DSN only — a console's
# "connect" snippet may include a `redis-cli -u ` prefix, which is not a DSN and
# makes the worker fail at import with `RuntimeError: invalid DSN scheme`.
REDIS_URL=redis://localhost:6379

# Browser origin(s) allowed through CORS (SPEC §8), comma-separated. Only needed
# if the frontend does not reach the browser on the default. A forwarded dev port
# counts as a different origin: VS Code / Codespaces may surface container :3000
# as http://127.0.0.1:3001, and CORS compares origins as exact strings.
# FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3001
#
# Or match origins by regex instead of naming each port. Handy in dev, where the
# forwarded port moves between sessions. Leave unset in a deployment.
# FRONTEND_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):[0-9]+

# ---------------------------------------------------------------------------
# Sign-in — GitHub OAuth (SPEC §13). Required from v2 phase V1 onward: every
# /repos route needs a session, so without these the API serves only /health,
# /ready, /metrics and a 503 from /auth/github/login.
# ---------------------------------------------------------------------------
# Register at github.com/settings/developers → New OAuth App:
#   Homepage URL          http://localhost:3000
#   Authorization callback http://localhost:8000/auth/github/callback
# The callback must match exactly — GitHub compares it as a string, and a
# trailing slash is a different URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs session tokens (§13.4). Any long random string; rotating it signs
# everyone out, which is the intended emergency lever.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Your own GitHub numeric id, if you have repos ingested from before auth
# existed. The §13.7 migration parks them on a placeholder user; setting this
# hands them to you on your first sign-in instead of stranding them.
#   curl -s https://api.github.com/users/<your-login> | grep '"id"'
# BOOTSTRAP_GITHUB_ID=

# ---------------------------------------------------------------------------
# THE ONE THING YOU MUST SET: a model API key for the agent.
# ---------------------------------------------------------------------------
# The AGENT_MODEL prefix selects the provider (SPEC §7.2):
#   mistral* -> ChatMistralAI           (needs MISTRAL_API_KEY)
#   gemini*  -> ChatGoogleGenerativeAI  (needs GOOGLE_API_KEY)
#   claude*  -> ChatAnthropic           (needs ANTHROPIC_API_KEY)
#   vertex:* -> ChatVertexAI            (needs GOOGLE_APPLICATION_CREDENTIALS + GCP_PROJECT)
#
# Default is Mistral: it is the provider every published number in this repo
# was measured on, and its free tier is token-metered (~1 RPS / 500K TPM),
# which is the shape an 8-tool agent loop needs. Get a key at
# console.mistral.ai — the free tier requires phone verification.
AGENT_MODEL=mistral-medium-latest
MISTRAL_API_KEY=

# Alternatives. Note AI Studio's free tier is 20 requests/day/model — roughly
# two agent runs — so it is smoke-test only, not a workhorse.
# Get a Google key at aistudio.google.com/apikey
# GOOGLE_API_KEY=
# Get an Anthropic key at console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Vertex AI — measurement runs and the strong-model cross-check ONLY.
# Default tuning traffic never routes through Vertex (DECISIONS 2026-07-26).
# Point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON stored
# OUTSIDE the repo; the key file is a live credential.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GCP_PROJECT=
# GCP_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Inference service (SPEC §16). Optional. Unset = load the model in-process,
# which is the right default for local dev and a single box.
# ---------------------------------------------------------------------------
# Run it with:
#   uv run uvicorn app.inference.main:service --port 8001
#
# Set this on API replicas: it takes them off torch entirely — measured
# 444 MB -> 83 MB resident, since the langchain type import that pulled torch
# was deferred at the same time (DECISIONS 2026-07-30).
#
# LEAVE IT UNSET on ingest workers. The chunker calls `token_len` once per
# oversize check (~1400 times on httpx) and each one would become a network
# round trip; a worker should hold the model it is there to use.
# INFERENCE_URL=http://localhost:8001
# INFERENCE_TIMEOUT_S=120

# Model defaults (override only if you know why).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Cross-encoder rerank — OFF by default (SPEC §5.3). It measured worse-or-equal
# to plain RRF fusion at every k and at MRR, for ~2.4 GB resident. Set true to
# re-enable (the model stays wired so the ablation is measurable).
# RERANK_ENABLED=false

# Hugging Face Hub token (optional). Raises download rate limits; without it
# model pulls still work but may be throttled. Get one at hf.co/settings/tokens.
# HF_TOKEN=

# (MISTRAL_API_KEY is set at the top — it is the default provider.)

# ---------------------------------------------------------------------------
# Serving limits (DECISIONS 2026-07-28). Every value below has a working
# default; set one only when the machine or the deployment disagrees with it.
# ---------------------------------------------------------------------------

# Connection pool. asyncpg's own default is min=max=10, which is a number nobody
# chose. Size MAX against Postgres's max_connections divided by your API
# replicas. DB_COMMAND_TIMEOUT_S bounds one statement in the API; the ingest
# worker sets its own (batch inserts legitimately run longer).
# DB_POOL_MIN_SIZE=5
# DB_POOL_MAX_SIZE=20
# DB_COMMAND_TIMEOUT_S=30
# DB_POOL_MAX_IDLE_S=300

# Concurrent agent runs, and the wall clock on one of them. The §7.2 tool cap
# bounds how many calls a run makes, never how long it may take.
# CHAT_MAX_CONCURRENCY=8
# CHAT_TIMEOUT_S=180
# AGENT_REQUEST_TIMEOUT_S=60

# Concurrent ingests (queued or running). Each is minutes of CPU on the same
# box that serves chat.
# MAX_ACTIVE_INGESTS=3

# Queue connection. ARQ's own default conn_timeout is 1s, which is a LAN
# number: a managed Redis across a region can take longer than that just to
# hand back a connection, and the timeout then kills the worker mid-job rather
# than failing one command. Raise if your Redis is far away or slow to accept.
# REDIS_CONN_TIMEOUT_S=10
# REDIS_RETRY_ON_TIMEOUT=true
# Command-level retries with exponential backoff, covering both TimeoutError
# and ConnectionError (a peer reset mid-command). Distinct from ARQ's
# conn_retries, which only wraps pool creation at startup.
# REDIS_COMMAND_RETRIES=3

# Per-IP rate limits, counted in Redis. Windows are per hour for the two
# expensive endpoints and per minute for everything else.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_INGEST_PER_HOUR=10
# RATE_LIMIT_CHAT_PER_HOUR=60
# RATE_LIMIT_DEFAULT_PER_MINUTE=120

# Believe X-Forwarded-For / X-Request-ID from the caller. Turn ON only behind a
# proxy you control: unproxied, both headers are attacker-supplied, and
# trusting the first turns every rate limit into a suggestion.
# TRUST_PROXY_HEADERS=false

# CPU-bound inference threads. INFERENCE_THREADS x TORCH_NUM_THREADS should
# land at or under the core count — oversubscribing makes every request slower,
# not just the extra ones.
# INFERENCE_THREADS=2
# TORCH_NUM_THREADS=2

# Observability. LOG_FORMAT=json for log shipping; every line carries the
# request id. /metrics is Prometheus text; set METRICS_TOKEN to require
# `Authorization: Bearer <token>` on a public deployment.
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# METRICS_ENABLED=true
# METRICS_TOKEN=
